{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heavener-co",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "heavener.co",
      "custom_domain": true
    }
  ]
}
